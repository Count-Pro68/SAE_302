CREATE DATABASE onionnet;
USE onionnet;

CREATE TABLE routers (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(50),
  host VARCHAR(50),
  port INT,
  pub_n TEXT,
  pub_e TEXT,
  last_seen TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE logs (
  id INT AUTO_INCREMENT PRIMARY KEY,
  origin VARCHAR(100),
  action VARCHAR(200),
  details TEXT,
  logtime TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
